<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover">
  <meta name="apple-mobile-web-app-capable" content="yes">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
  <meta name="theme-color" content="#0052cc">
  <link rel="manifest" href="manifest.json">
  <title>Mobile PDF Reader</title>
  
  <!-- PDF.js CDN -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.min.js"></script>

  <style>
    :root {
      --bg-color: #f4f5f7;
      --card-bg: #ffffff;
      --text-color: #172b4d;
      --primary: #0052cc;
      --border-color: #dfe1e6;
      --toolbar-bg: rgba(255, 255, 255, 0.95);
    }

    body.dark-mode {
      --bg-color: #121212;
      --card-bg: #1e1e1e;
      --text-color: #e0e0e0;
      --primary: #4c9aff;
      --border-color: #333333;
      --toolbar-bg: rgba(30, 30, 30, 0.95);
    }

    * {
      box-sizing: border-box;
      -webkit-tap-highlight-color: transparent;
    }

    body {
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
      background-color: var(--bg-color);
      color: var(--text-color);
      margin: 0;
      padding: 0;
      touch-action: manipulation;
      user-select: none;
      overscroll-behavior-y: none;
    }

    header {
      background-color: var(--toolbar-bg);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      padding: max(12px, env(safe-area-inset-top)) 16px 12px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      position: sticky;
      top: 0;
      z-index: 100;
    }

    .btn {
      background-color: var(--primary);
      color: white;
      border: none;
      padding: 8px 12px;
      border-radius: 8px;
      cursor: pointer;
      font-weight: 600;
      min-height: 40px;
      font-size: 13px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 4px;
    }

    .btn-secondary { background-color: transparent; border: 1px solid var(--border-color); color: var(--text-color); }
    .btn-danger { background-color: #de350b; }

    #library-view {
      padding: 16px;
      max-width: 600px;
      margin: 0 auto;
    }

    .upload-box {
      border: 2px dashed var(--border-color);
      border-radius: 12px;
      padding: 24px;
      text-align: center;
      background: var(--card-bg);
      margin-bottom: 24px;
    }

    .book-grid {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .book-card {
      background: var(--card-bg);
      border: 1px solid var(--border-color);
      border-radius: 12px;
      padding: 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .book-info {
      flex: 1;
      margin-right: 12px;
    }

    .book-title {
      font-weight: 600;
      font-size: 15px;
      margin-bottom: 4px;
      word-break: break-word;
    }

    .book-meta {
      font-size: 12px;
      opacity: 0.7;
    }

    .card-actions {
      display: flex;
      gap: 8px;
    }

    #reader-view {
      display: none;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      position: relative;
      overflow: hidden;
    }

    #reader-toolbar {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      background: var(--toolbar-bg);
      backdrop-filter: blur(10px);
      border-bottom: 1px solid var(--border-color);
      padding: max(8px, env(safe-area-inset-top)) 8px 8px 8px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 4px;
      z-index: 100;
      transition: transform 0.25s ease;
    }

    #reader-toolbar.hidden {
      transform: translateY(-100%);
    }

    #canvas-container {
      width: 100vw;
      height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      overflow: auto;
    }

    canvas {
      display: block;
      margin: auto;
      max-width: 100vw;
    }

    body.dark-mode #pdf-canvas {
      filter: invert(0.88) hue-rotate(180deg);
    }

    #page-indicator {
      position: fixed;
      bottom: max(20px, env(safe-area-inset-bottom));
      background: rgba(0, 0, 0, 0.7);
      color: white;
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      pointer-events: none;
      opacity: 0.8;
      z-index: 90;
    }
  </style>
</head>
<body>

  <header>
    <h3 style="margin:0;">📚 My PDF Books</h3>
    <button class="btn btn-secondary" id="toggle-dark">🌙</button>
  </header>

  <div id="library-view">
    <div class="upload-box">
      <p style="margin-top:0;">Add a PDF book from Files</p>
      <input type="file" id="file-input" accept=".pdf,application/pdf" style="display:none;">
      <button class="btn" onclick="document.getElementById('file-input').click()">Upload PDF</button>
    </div>

    <div class="book-grid" id="book-grid"></div>
  </div>

  <div id="reader-view">
    <div id="reader-toolbar">
      <button class="btn btn-secondary" id="back-to-lib">← Lib</button>
      <span style="font-size: 12px;"><span id="page-num">1</span>/<span id="page-count">?</span></span>
      <button class="btn" id="tts-btn">🔊 Listen</button>
      <button class="btn btn-secondary" id="speed-btn">1.0x</button>
      <button class="btn btn-secondary" id="fit-width">📱 Fit</button>
    </div>

    <div id="canvas-container">
      <canvas id="pdf-canvas"></canvas>
    </div>

    <div id="page-indicator">Swipe or tap sides to flip</div>
  </div>

  <script>
    const CMAP_URL = 'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/cmaps/';
    
    pdfjsLib.GlobalWorkerOptions.workerSrc = 
      'https://cdnjs.cloudflare.com/ajax/libs/pdf.js/3.11.174/pdf.worker.min.js';

    const DB_NAME = 'MobilePdfReaderDB';
    const STORE_NAME = 'books';
    
    function openDB() {
      return new Promise((resolve, reject) => {
        const request = indexedDB.open(DB_NAME, 1);
        request.onupgradeneeded = e => {
          const db = e.target.result;
          if (!db.objectStoreNames.contains(STORE_NAME)) {
            db.createObjectStore(STORE_NAME, { keyPath: 'id' });
          }
        };
        request.onsuccess = () => resolve(request.result);
        request.onerror = () => reject(request.error);
      });
    }

    async function saveBookToDB(file) {
      try {
        const arrayBuffer = await file.arrayBuffer();
        const pdfCopy = arrayBuffer.slice(0);
        const pdf = await pdfjsLib.getDocument({
          data: pdfCopy,
          cMapUrl: CMAP_URL,
          cMapPacked: true
        }).promise;
        
        const book = {
          id: 'book_' + Date.now(),
          title: file.name.replace(/\.pdf$/i, ''),
          data: arrayBuffer,
          totalPages: pdf.numPages,
          lastPage: 1
        };

        const db = await openDB();
        const tx = db.transaction(STORE_NAME, 'readwrite');
        tx.objectStore(STORE_NAME).put(book);
        
        tx.oncomplete = () => {
          document.getElementById('file-input').value = '';
          loadLibrary();
        };
      } catch (err) {
        alert('Failed to process PDF: ' + err.message);
      }
    }

    async function updatePageProgress(bookId, pageNum) {
      const db = await openDB();
      const tx = db.transaction(STORE_NAME, 'readwrite');
      const store = tx.objectStore(STORE_NAME);
      const book = await new Promise(res => store.get(bookId).onsuccess = e => res(e.target.result));
      if (book) {
        book.lastPage = pageNum;
        store.put(book);
      }
    }

    async function deleteBook(bookId) {
      if (confirm('Delete this book?')) {
        const db = await openDB();
        const tx = db.transaction(STORE_NAME, 'readwrite');
        tx.objectStore(STORE_NAME).delete(bookId);
        tx.oncomplete = () => loadLibrary();
      }
    }

    async function loadLibrary() {
      const db = await openDB();
      const tx = db.transaction(STORE_NAME, 'readonly');
      const books = await new Promise(res => tx.objectStore(STORE_NAME).getAll().onsuccess = e => res(e.target.result));
      
      const grid = document.getElementById('book-grid');
      grid.innerHTML = books.length ? '' : '<p style="text-align:center; opacity:0.6;">No books uploaded yet.</p>';

      books.forEach(book => {
        const progress = Math.round((book.lastPage / book.totalPages) * 100);
        const card = document.createElement('div');
        card.className = 'book-card';
        card.innerHTML = `
          <div class="book-info">
            <div class="book-title">${book.title}</div>
            <div class="book-meta">Page ${book.lastPage} of ${book.totalPages} (${progress}%)</div>
          </div>
          <div class="card-actions">
            <button class="btn" onclick="openReader('${book.id}')">Read</button>
            <button class="btn btn-danger" onclick="deleteBook('${book.id}')">✕</button>
          </div>
        `;
        grid.appendChild(card);
      });
    }

    let currentBook = null;
    let pdfDoc = null;
    let currentPageObj = null;
    let pageNum = 1;
    let scale = 1.0;
    let pageRendering = false;
    let pageNumPending = null;
    
    // TTS State
    let isSpeaking = false;
    let currentSpeechRate = 1.0;
    const speechRates = [0.8, 1.0, 1.25, 1.5, 1.8, 2.0];
    let rateIndex = 1;
    let wakeLock = null;
    let currentPageText = "";

    const canvas = document.getElementById('pdf-canvas');
    const ctx = canvas.getContext('2d');
    const ttsBtn = document.getElementById('tts-btn');
    const speedBtn = document.getElementById('speed-btn');

    async function openReader(bookId) {
      const db = await openDB();
      const tx = db.transaction(STORE_NAME, 'readonly');
      currentBook = await new Promise(res => tx.objectStore(STORE_NAME).get(bookId).onsuccess = e => res(e.target.result));

      document.getElementById('library-view').style.display = 'none';
      document.querySelector('header').style.display = 'none';
      document.getElementById('reader-view').style.display = 'flex';
      document.getElementById('page-count').textContent = currentBook.totalPages;

      pdfDoc = await pdfjsLib.getDocument({
        data: currentBook.data.slice(0),
        cMapUrl: CMAP_URL,
        cMapPacked: true
      }).promise;

      pageNum = currentBook.lastPage || 1;
      renderPage(pageNum);
    }

    function renderPage(num) {
      pageRendering = true;

      if (currentPageObj) {
        currentPageObj.cleanup();
      }

      pdfDoc.getPage(num).then(page => {
        currentPageObj = page;
        const unscaledViewport = page.getViewport({ scale: 1.0 });
        const screenWidth = window.innerWidth;
        scale = screenWidth / unscaledViewport.width;

        const viewport = page.getViewport({ scale: scale });
        canvas.height = viewport.height;
        canvas.width = viewport.width;

        const renderContext = { canvasContext: ctx, viewport: viewport };
        const renderTask = page.render(renderContext);

        renderTask.promise.then(() => {
          pageRendering = false;
          if (pageNumPending !== null) {
            renderPage(pageNumPending);
            pageNumPending = null;
          }
        });
      });

      document.getElementById('page-num').textContent = num;
      updatePageProgress(currentBook.id, num);
    }

    function queueRenderPage(num) {
      if (pageRendering) pageNumPending = num;
      else renderPage(num);
    }

    function nextPage() {
      if (pageNum >= pdfDoc.numPages) return;
      stopSpeech();
      pageNum++;
      queueRenderPage(pageNum);
    }

    function prevPage() {
      if (pageNum <= 1) return;
      stopSpeech();
      pageNum--;
      queueRenderPage(pageNum);
    }

    // --- Wake Lock for Screen ---
    async function requestWakeLock() {
      if ('wakeLock' in navigator) {
        try { wakeLock = await navigator.wakeLock.request('screen'); } catch (e) {}
      }
    }

    function releaseWakeLock() {
      if (wakeLock) {
        wakeLock.release().then(() => wakeLock = null);
      }
    }

    // --- Text To Speech (Arabic Clean Decoding) ---
    async function readCurrentPageText() {
      if (!('speechSynthesis' in window)) {
        alert('Text-to-Speech is not supported in this browser.');
        return;
      }

      try {
        const page = await pdfDoc.getPage(pageNum);
        const textContent = await page.getTextContent();
        
        let rawText = textContent.items.map(item => item.str).join(' ');
        
        // Sanitize stray dots/unprintable characters
        currentPageText = rawText
          .replace(/[\u200B-\u200D\uFEFF]/g, '') // remove zero-width chars
          .replace(/(\. ){2,}/g, '')            // remove repeating dot sequences
          .replace(/\.{2,}/g, '')
          .trim();

        if (!currentPageText) {
          alert('No readable text found on this page (it may be an image PDF).');
          stopSpeech();
          return;
        }

        speakText(currentPageText);
      } catch (err) {
        alert('Speech error: ' + err.message);
        stopSpeech();
      }
    }

    function speakText(text) {
      window.speechSynthesis.cancel();

      setTimeout(() => {
        if (!isSpeaking) return;

        const utterance = new SpeechSynthesisUtterance(text);
        
        const hasArabic = /[\u0600-\u06FF]/.test(text);
        utterance.lang = hasArabic ? 'ar-SA' : 'en-US';
        utterance.rate = currentSpeechRate;

        // Force Arabic Siri Voice on iOS if available
        if (hasArabic) {
          const voices = window.speechSynthesis.getVoices();
          const arVoice = voices.find(v => v.lang.startsWith('ar'));
          if (arVoice) utterance.voice = arVoice;
        }

        utterance.onend = () => {
          if (isSpeaking && pageNum < pdfDoc.numPages) {
            pageNum++;
            renderPage(pageNum);
            readCurrentPageText();
          } else {
            stopSpeech();
          }
        };

        utterance.onerror = () => stopSpeech();

        requestWakeLock();
        window.speechSynthesis.speak(utterance);
      }, 50);
    }

    function stopSpeech() {
      if ('speechSynthesis' in window) {
        window.speechSynthesis.cancel();
      }
      isSpeaking = false;
      releaseWakeLock();
      ttsBtn.textContent = '🔊 Listen';
      ttsBtn.classList.remove('btn-danger');
    }

    ttsBtn.onclick = () => {
      if (isSpeaking) {
        stopSpeech();
      } else {
        isSpeaking = true;
        ttsBtn.textContent = '⏸️ Stop';
        ttsBtn.classList.add('btn-danger');
        readCurrentPageText();
      }
    };

    speedBtn.onclick = () => {
      rateIndex = (rateIndex + 1) % speechRates.length;
      currentSpeechRate = speechRates[rateIndex];
      speedBtn.textContent = currentSpeechRate + 'x';

      if (isSpeaking && currentPageText) {
        speakText(currentPageText);
      }
    };

    let touchStartX = 0;
    let touchStartY = 0;

    const container = document.getElementById('canvas-container');

    container.addEventListener('touchstart', e => {
      touchStartX = e.changedTouches[0].clientX;
      touchStartY = e.changedTouches[0].clientY;
    }, { passive: true });

    container.addEventListener('touchend', e => {
      const touchEndX = e.changedTouches[0].clientX;
      const touchEndY = e.changedTouches[0].clientY;

      const diffX = touchEndX - touchStartX;
      const diffY = touchEndY - touchStartY;

      if (Math.abs(diffX) > 50 && Math.abs(diffX) > Math.abs(diffY)) {
        if (diffX < 0) nextPage();
        else prevPage();
      } else if (Math.abs(diffX) < 10 && Math.abs(diffY) < 10) {
        const screenWidth = window.innerWidth;
        if (touchEndX < screenWidth * 0.3) {
          prevPage();
        } else if (touchEndX > screenWidth * 0.7) {
          nextPage();
        } else {
          document.getElementById('reader-toolbar').classList.toggle('hidden');
        }
      }
    }, { passive: true });

    window.addEventListener('resize', () => {
      if (pdfDoc && document.getElementById('reader-view').style.display === 'flex') {
        renderPage(pageNum);
      }
    });

    document.getElementById('back-to-lib').onclick = () => {
      stopSpeech();
      document.getElementById('reader-view').style.display = 'none';
      document.querySelector('header').style.display = 'flex';
      document.getElementById('library-view').style.display = 'block';
      loadLibrary();
    };

    document.getElementById('fit-width').onclick = () => renderPage(pageNum);

    document.getElementById('file-input').onchange = e => {
      const file = e.target.files[0];
      if (!file) return;

      const isPdf = (file.type && file.type.includes('pdf')) || file.name.toLowerCase().endsWith('.pdf');
      
      if (isPdf) {
        saveBookToDB(file);
      } else {
        alert('Please select a file ending in .pdf');
      }
    };

    const darkToggleBtn = document.getElementById('toggle-dark');
    darkToggleBtn.onclick = () => {
      document.body.classList.toggle('dark-mode');
      const isDark = document.body.classList.contains('dark-mode');
      localStorage.setItem('theme', isDark ? 'dark' : 'light');
      darkToggleBtn.textContent = isDark ? '☀️' : '🌙';
    };

    if (localStorage.getItem('theme') === 'dark') {
      document.body.classList.add('dark-mode');
      darkToggleBtn.textContent = '☀️';
    }

    loadLibrary();

    if ('serviceWorker' in navigator) {
      window.addEventListener('load', () => {
        navigator.serviceWorker.register('./sw.js')
          .then(reg => console.log('Service Worker Registered'))
          .catch(err => console.error('Service Worker Registration Failed:', err));
      });
    }
  </script>
</body>
</html>
